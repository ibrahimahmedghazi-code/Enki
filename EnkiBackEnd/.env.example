# Copy to `.env` next to pyproject.toml.

# Postgres in Podman (match POSTGRES_PASSWORD from `podman run -e POSTGRES_PASSWORD=...`)
# Database name `enki` — create it first: see enkiDataBase.sql header or scripts/init_enki_db.sh

# Optional: SQLite fallback when DATABASE_URL is unset
# SQLITE_PATH=enki.db
